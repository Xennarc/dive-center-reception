+/* ---------- Lock protocol ---------- */
+
+function _lockName(fileName, sessionId) {
+  return `~$${fileName}.savelock.${sessionId}`;
+}
+function _lockPrefix(fileName) {
+  return `~$${fileName}.savelock.`;
+}
+
+async function _writeLockFile(handle, body) {
+  const w = await handle.createWritable();
+  await w.write(JSON.stringify(body));
+  await w.close();
+}
+
+async function acquireLock(fileName) {
+  if (STATE.mode !== 'fs' || !STATE.dirHandle) return null;
+  const sessionId = SESSION_ID;
+  if (!sessionId) return null;
+  const candidateName = _lockName(fileName, sessionId);
+
+  for (let attempt = 0; attempt < 5; attempt++) {
+    let candidateHandle = null;
+    try {
+      candidateHandle = await STATE.dirHandle.getFileHandle(candidateName, { create: true });
+      await _writeLockFile(candidateHandle, {
+        userId: STATE.userId || 'unknown',
+        sessionId,
+        ts: Date.now(),
+      });
+    } catch (e) {
+      console.warn('lock candidate write failed', e);
+      // back off and retry
+      await _sleep(_jitter(500, 2000));
+      continue;
+    }
+
+    // List all candidates for this file in the dir, drop stale ones.
+    const prefix = _lockPrefix(fileName);
+    const live = [];
+    try {
+      for await (const [name, h] of STATE.dirHandle.entries()) {
+        if (h.kind !== 'file' || !name.startsWith(prefix)) continue;
+        let mtime = 0;
+        try { mtime = (await h.getFile()).lastModified || 0; } catch (_) {}
+        const isStale = mtime > 0 && (Date.now() - mtime) > 30000;
+        if (isStale) {
+          // Best-effort cleanup of stale locks
+          try { await STATE.dirHandle.removeEntry(name); } catch (_) {}
+          continue;
+        }
+        const sid = name.slice(prefix.length);
+        live.push({ name, sid, handle: h });
+      }
+    } catch (e) {
+      console.warn('lock list failed', e);
+      try { await STATE.dirHandle.removeEntry(candidateName); } catch (_) {}
+      await _sleep(_jitter(500, 2000));
+      continue;
+    }
+
+    // Smallest non-stale sessionId wins.
+    live.sort((a, b) => a.sid < b.sid ? -1 : a.sid > b.sid ? 1 : 0);
+    const winner = live[0];
+    if (winner && winner.sid === sessionId) {
+      // We hold the lock. Start a heartbeat so our mtime stays fresh.
+      const heartbeat = setInterval(() => {
+        _writeLockFile(candidateHandle, {
+          userId: STATE.userId || 'unknown',
+          sessionId,
+          ts: Date.now(),
+        }).catch((e) => console.warn('lock heartbeat', e));
+      }, 10000);
+      return { fileName, candidateName, candidateHandle, heartbeat };
+    }
+
+    // Someone else is ahead of us. Drop our candidate, jittered backoff, retry.
+    try { await STATE.dirHandle.removeEntry(candidateName); } catch (_) {}
+    await _sleep(_jitter(500, 2000));
+  }
+  return null;
+}
