+async function releaseLock(lock) {
+  if (!lock) return;
+  if (lock.heartbeat) clearInterval(lock.heartbeat);
+  try { await STATE.dirHandle.removeEntry(lock.candidateName); } catch (e) { console.warn('lock remove', e); }
+}
+
+function _sleep(ms) { return new Promise(r => setTimeout(r, ms)); }
+function _jitter(min, max) { return Math.floor(min + Math.random() * (max - min)); }
