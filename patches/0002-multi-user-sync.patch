+/* ============================================================
+   Sync (multi-user)
+   - Op-log: every booking/meta mutation appends a structured op to the
+     file's pendingOps. On save we re-stat the disk; if it's moved on,
+     we reload and replay our ops on top. New-booking ops get reallocated
+     to the next free row when their original target is now occupied.
+   - Cooperative lock: a `~$<filename>.savelock.<sessionId>` file in the
+     shared folder gates concurrent writers. Stale locks (mtime > 30s)
+     are ignored. The smallest sessionId among non-stale candidates wins.
+   - Background poll: every 8s we re-stat each file. If it's newer than
+     our `lastSyncedMtime` and we're not locally dirty, we silently
+     reload. If we ARE dirty, we set `remoteChanged` so the next save
+     takes the conflict path.
+   - 'fp' (manual file picker) mode is a no-op for all sync code paths.
+   ============================================================ */
+
+// Per-tab session id, generated once when the workspace is shown. Used to
+// distinguish our own lock candidates from peers'.
+let SESSION_ID = null;
+
+// When true, recordOp + writeBooking's sync rebuildBookings are suppressed.
+// Set during conflict-replay so we mutate the freshly-loaded workbook in
+// place without recursive op recording.
+let replaying = false;
+
+// Background poller interval id.
+let _pollTimer = null;
+
+function _uuid() {
+  if (typeof crypto !== 'undefined' && crypto.randomUUID) return crypto.randomUUID();
+  return String(Date.now()) + '-' + Math.random().toString(36).slice(2, 10);
+}
+
+function recordOp(fileEntry, op) {
+  if (replaying) return;
+  if (!fileEntry.pendingOps) fileEntry.pendingOps = [];
+  fileEntry.pendingOps.push(op);
+}
+
+/**
+ * Replay an op-log onto a freshly-reloaded workbook. Called from saveAll
+ * when the on-disk mtime has moved past our last-synced value. Groups
+ * ops by txnId so multi-op operations (postpone) stay atomic, and
+ * reallocates new-booking rows that are now occupied. Skipped ops
+ * (sheet vanished) are collected and surfaced as a single toast.
+ */
+async function replayOps(fileEntry, ops) {
+  const tempIdToRow = new Map(); // bookingTempId -> resolved rowIdx
+  const skipped = [];
+  replaying = true;
+  try {
+    for (const op of ops) {
+      const sheetEntry = fileEntry.sheets.find(s => s.sheetName === op.sheetName);
+      if (!sheetEntry) { skipped.push(op); continue; }
+
+      if (op.kind === 'writeBooking') {
+        let row = op.rowIdx;
+        if (op.isNew) {
+          // Re-scan empty rows; if our intendedRow is taken, allocate the next.
+          const lay = sheetEntry.layout;
+          let chosen = -1;
+          for (let r = lay.firstBooking; r <= lay.lastBooking; r++) {
+            const b = readBooking(sheetEntry.ws, sheetEntry.sheetName, fileEntry.name, lay, r,
+              fileEntry.excursionName, lay.dateISO, lay.capacity, fileEntry.excursionColor, fileEntry);
+            const m = getBookingMeta(fileEntry, sheetEntry.sheetName, r);
+            if (b.isEmpty && (m.status === 'active' || !m.status)) { chosen = r; break; }
+          }
+          if (chosen < 0) { skipped.push(op); continue; }
+          row = chosen;
+          if (op.bookingTempId) tempIdToRow.set(op.bookingTempId, row);
+        } else if (op.bookingTempId && tempIdToRow.has(op.bookingTempId)) {
+          row = tempIdToRow.get(op.bookingTempId);
+        }
+        writeBooking(fileEntry, op.sheetName, row, op.fields, {
