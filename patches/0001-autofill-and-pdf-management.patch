 /**
- * Lookup guest by room + booking date.
+ * Lookup guest by room (and optionally booking date).
+ * Always returns the best available record for the room — fields the user
+ * hasn't filled in are autofilled from the most relevant PDF row.
  * Returns:
- *   {match: record} when a current, valid match is found
- *   {match: null, reason: 'none' | 'outdated' | 'noreports' | 'norange'}
+ *   {match: record}                 → in-residence match for the booking date
+ *   {match: record, stale: true}    → in-range match but reports are older than booking date
+ *   {match: record, roomOnly: true} → no in-range match, fell back to most recent record
+ *   {match: null, reason: 'noreports'}  → no PDFs loaded
+ *   {match: null, reason: 'none'}       → room not found in any PDF
  */
 function lookupInhouse(room, dateISO) {
   if (!STATE.inhouseGuests.length) return {match: null, reason: 'noreports'};
-  if (!room || !dateISO) return {match: null, reason: 'none'};
-  if (!isInhouseDataCurrent(dateISO)) return {match: null, reason: 'outdated', latest: inhouseLatestBusinessDate()};
-  const r = String(room).replace(/[^\w]/g, '').trim().toLowerCase();
+  const r = String(room || '').replace(/[^\w]/g, '').trim().toLowerCase();
   if (!r) return {match: null, reason: 'none'};
-  const matches = STATE.inhouseGuests.filter(g => {
-    if (String(g.room).toLowerCase() !== r) return false;
-    if (g.arrival && dateISO < g.arrival) return false;
-    if (g.departure && dateISO > g.departure) return false;
-    return true;
-  });
-  if (!matches.length) return {match: null, reason: 'none'};
-  matches.sort((a, b) => (b.businessDate || '').localeCompare(a.businessDate || ''));
-  return {match: matches[0]};
+
+  const allRoomMatches = STATE.inhouseGuests.filter(g => String(g.room).toLowerCase() === r);
+  if (!allRoomMatches.length) return {match: null, reason: 'none'};
+
+  const latest = inhouseLatestBusinessDate();
+
+  if (dateISO) {
+    const inRange = allRoomMatches.filter(g => {
+      if (g.arrival && dateISO < g.arrival) return false;
+      if (g.departure && dateISO > g.departure) return false;
+      return true;
+    });
+    if (inRange.length) {
+      inRange.sort((a, b) => (b.businessDate || '').localeCompare(a.businessDate || ''));
+      const stale = !isInhouseDataCurrent(dateISO);
+      return stale ? {match: inRange[0], stale: true, latest} : {match: inRange[0]};
+    }
+  }
+
+  allRoomMatches.sort((a, b) => (b.businessDate || '').localeCompare(a.businessDate || ''));
+  return {match: allRoomMatches[0], roomOnly: true, latest};
 }
 
